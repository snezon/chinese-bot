  "title": "Время и частота",
  "words": [
    {
      "hanzi": "经常",
      "pinyin": "jīngcháng",
      "ru": "часто / постоянно",
      "mnemonic": "经(проходить) + 常(обычный) — постоянно проходить = часто",
      "etymology": "经 = нить основы ткани = регулярный"
    },
    {
      "hanzi": "有时候",
      "pinyin": "yǒu shíhou",
      "ru": "иногда",
      "mnemonic": "有(есть) + 时候(время) — есть такое время = иногда",
      "etymology": "Буквально: существует такой момент"
    },
    {
      "hanzi": "已经",
      "pinyin": "yǐjīng",
      "ru": "уже",
      "mnemonic": "已(уже/завершить) + 经(проходить) — уже прошло",
      "etymology": "已 = свёрнутая змея = завершение"
    },
    {
      "hanzi": "还",
      "pinyin": "hái",
      "ru": "ещё / всё ещё / тоже",
      "mnemonic": "辶(движение) + 不(не) — не прекращается движение = ещё",
      "etymology": "Продолжение движения = ещё"
    },
    {
      "hanzi": "再",
      "pinyin": "zài",
      "ru": "снова / опять / ещё раз",
      "mnemonic": "一(один) + 冉(медленно) — ещё один медленный раз",
      "etymology": "Повторение"
    },
    {
      "hanzi": "以后",
      "pinyin": "yǐhòu",
      "ru": "после / потом / в будущем",
      "mnemonic": "以(брать) + 后(после) — взять будущее после этого",
      "etymology": "以 = использовать; 后 = после"
    },
    {
      "hanzi": "以前",
      "pinyin": "yǐqián",
      "ru": "раньше / до / прежде",
      "mnemonic": "以(брать) + 前(перед) — то, что было перед",
      "etymology": "Время перед настоящим"
    }
  ],
  "grammar": "Частотные наречия ставятся ПЕРЕД глаголом: 我经常吃苹果(Я часто ем яблоки). 已经...了: 我已经吃了(Я уже поел). 以后(в будущем) vs 后来(потом, последовательность).",
  "examples": [
    "我经常去学校 — Я часто хожу в школу",
    "他已经回家了 — Он уже вернулся домой",
    "以后我想去中国 — В будущем хочу поехать в Китай"
  ],
